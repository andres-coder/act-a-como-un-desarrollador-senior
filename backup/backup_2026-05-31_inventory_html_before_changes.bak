{% extends 'base.html' %}
{% block title %}Inventario | Bemba{% endblock %}
{% block heading %}Inventario{% endblock %}
{% block content %}
<section class="panel">
  <div class="panel-title">Ingredientes</div>
  <p>Monitorea el inventario con una presentación moderna que facilita encontrar los ingredientes críticos en una vista rápida.</p>
</section>

<section class="inventory-grid">
  {% for ingredient in ingredients %}
  <article class="inventory-card">
    <div>
      <span>{{ ingredient.name }}</span>
      <strong>{{ ingredient.current_stock }} {{ ingredient.unit }}</strong>
    </div>
    <div>
      <small>Mínimo: {{ ingredient.min_stock }}</small>
      <strong>${{ ingredient.unit_cost }}</strong>
    </div>
  </article>
  {% empty %}
  <p class="empty-state">No hay ingredientes registrados.</p>
  {% endfor %}
</section>
{% endblock %}
