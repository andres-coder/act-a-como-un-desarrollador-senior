:root {
  --ink: #172026;
  --muted: #6b7280;
  --line: #e5e7eb;
  --paper: #f6f7f8;
  --accent: #0f766e;
  --warning: #c2410c;
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.sidebar { position: fixed; inset: 0 auto 0 0; width: 248px; background: #111827; color: white; padding: 24px; }
.brand { font-size: 28px; font-weight: 800; letter-spacing: 0; }
.brand span { color: #5eead4; margin-left: 4px; }
.sidebar nav { display: grid; gap: 8px; margin-top: 32px; }
.sidebar a { color: #d1d5db; text-decoration: none; padding: 11px 12px; border-radius: 8px; }
.sidebar a:hover { background: rgba(255,255,255,.08); color: white; }
.content { margin-left: 248px; padding: 28px; }
.topbar { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin-bottom: 24px; }
.topbar small, .metric span, .panel-title + small { color: var(--muted); }
.topbar h1 { margin: 0; font-size: 30px; }
.user-chip { background: white; border: 1px solid var(--line); padding: 10px 14px; border-radius: 8px; color: var(--ink); }
.user-chip:hover, .user-chip:focus { border-color: var(--accent); background: white; color: var(--ink); }
.user-menu { border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 14px 32px rgba(15, 23, 42, .12); }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
.metric, .panel, .table-card, .kitchen-ticket, .receipt { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 18px; box-shadow: 0 10px 24px rgba(15, 23, 42, .04); }
.metric strong { display: block; font-size: 28px; margin-top: 8px; }
.panel-title { font-weight: 800; font-size: 18px; margin-bottom: 12px; }
.table-map, .menu-grid, .kanban { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; }
.table-card { min-height: 140px; display: grid; align-content: space-between; }
.table-card strong { font-size: 24px; }
.table-card.available { border-color: #14b8a6; }
.table-card.occupied { border-color: var(--warning); }
.table-card.reserved { border-color: #2563eb; }
.pos-layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; }
.checkout-layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; }
.menu-item { text-align: left; border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 16px; min-height: 130px; }
.menu-item span, .menu-item small { color: var(--muted); display: block; }
.menu-item strong { display: block; font-size: 18px; margin: 10px 0; }
.order-panel { position: sticky; top: 20px; align-self: start; }
.cart-empty { min-height: 220px; display: grid; place-items: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 8px; text-align: center; padding: 16px; }
.open-orders { display: grid; gap: 8px; max-height: 260px; overflow: auto; }
.open-orders a { display: flex; justify-content: space-between; gap: 10px; border: 1px solid var(--line); border-radius: 8px; padding: 10px; color: var(--ink); text-decoration: none; }
.open-orders a:hover { border-color: var(--accent); }
.kitchen-ticket { min-height: 190px; border-left: 5px solid var(--accent); }
.receipt { max-width: 420px; margin: 0 auto; }
.receipt-row { display: flex; justify-content: space-between; gap: 12px; margin: 8px 0; }
.receipt-row.total { font-size: 22px; }
.report-filters { display: grid; grid-template-columns: repeat(2, minmax(180px, 260px)) auto; gap: 16px; align-items: end; margin-bottom: 18px; }
.report-filter-actions { display: flex; gap: 10px; }
.method-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
.method-grid article { border: 1px solid var(--line); border-radius: 8px; padding: 14px; }
.method-grid span, .method-grid small { color: var(--muted); display: block; }
.method-grid strong { display: block; font-size: 22px; margin: 6px 0; }
.login-screen { min-height: 100vh; display: grid; place-items: center; background: linear-gradient(135deg, #111827, #0f766e); padding: 20px; }
.login-panel { width: min(440px, 100%); background: white; border-radius: 8px; padding: 32px; }

@media (max-width: 900px) {
  .sidebar { position: static; width: auto; }
  .sidebar nav { grid-template-columns: repeat(3, 1fr); margin-top: 16px; }
  .content { margin-left: 0; padding: 18px; }
  .metric-grid, .pos-layout, .checkout-layout, .report-filters { grid-template-columns: 1fr; }
  .topbar { align-items: flex-start; flex-direction: column; }
}
