:root {
  --ink: #1f2937;
  --muted: #66717e;
  --line: #d9cbbf;
  --paper: #f8f3ed;
  --surface: #ffffff;
  --surface-soft: #f3e9dd;
  --surface-alt: #eee0d4;
  --accent: #8f6a45;
  --accent-strong: #a26430;
  --accent-soft: #f5e2d0;
  --highlight: #c07c4a;
  --success: #207d4a;
  --warning: #b45309;
  --danger: #b91c1c;
  --shadow: 0 18px 40px rgba(31, 41, 55, 0.08);
}

* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top left, rgba(192, 124, 74, 0.14), transparent 28%), linear-gradient(180deg, #f8f3ed 0%, #fbf7f2 100%);
  color: var(--ink);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
html { scroll-behavior: smooth; }

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 260px;
  background: #3f2f25;
  color: #f8f5f0;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  justify-content: start;
  gap: 28px;
}

.brand {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.brand span {
  display: inline-block;
  color: #f9d2ac;
  margin-left: 6px;
  font-weight: 600;
}

.sidebar nav {
  display: grid;
  gap: 10px;
}

.sidebar a {
  color: #f1e7df;
  text-decoration: none;
  padding: 14px 16px;
  border-radius: 16px;
  transition: background 0.25s ease, color 0.25s ease;
}

.sidebar a:hover,
.sidebar a:focus {
  background: rgba(255,255,255,0.10);
  color: #ffffff;
}

.content {
  margin-left: 260px;
  padding: 32px;
  min-height: 100vh;
}

.topbar {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
  margin-bottom: 28px;
  padding: 20px 24px;
  background: rgba(255,255,255,0.82);
  border: 1px solid rgba(255,255,255,0.6);
  border-radius: 24px;
  backdrop-filter: blur(14px);
  box-shadow: var(--shadow);
}

.topbar small {
  display: block;
  color: var(--muted);
  font-size: 0.95rem;
}

.topbar h1 {
  margin: 6px 0 0;
  font-size: 2.1rem;
}

.user-chip {
  background: #fff;
  border: 1px solid rgba(217, 203, 191, 0.7);
  padding: 11px 18px;
  border-radius: 999px;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 10px 24px rgba(31,41,55,0.08);
}

.user-menu {
  border: none;
  border-radius: 18px;
  overflow: hidden;
}

.metric-grid,
.table-map,
.menu-grid,
.kanban,
.inventory-grid,
.method-grid,
.kitchen-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
}

.metric,
.panel,
.table-card,
.recipe-card,
.ticket-card,
.inventory-card,
.report-card,
.summary-chip {
  background: var(--surface);
  border: 1px solid rgba(217, 203, 191, 0.8);
  border-radius: 24px;
  padding: 24px;
  box-shadow: var(--shadow);
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.metric span,
.panel-title,
.ticket-card__meta,
.item-details small,
.table-card small,
.report-card small,
.inventory-card small {
  color: var(--muted);
}

.metric strong,
.panel-title,
.ticket-card__header strong,
.menu-item strong,
.inventory-card strong,
.report-card strong {
  display: block;
  font-size: 1.6rem;
  font-weight: 700;
}

.metric span,
.panel-title {
  font-size: 0.95rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.panel-title {
  margin-bottom: 18px;
}

.panel {
  width: 100%;
}

.table-map,
.kitchen-grid,
.inventory-grid,
.method-grid {
  align-items: stretch;
}

.dashboard-intro {
  margin-bottom: 18px;
}

.dashboard-intro p {
  margin: 0;
  color: var(--muted);
  line-height: 1.75;
}

.table-card {
  min-height: 160px;
  display: grid;
  gap: 14px;
}

.table-card__tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(144, 102, 68, 0.12);
  color: #7b4e2f;
  font-size: 0.86rem;
  letter-spacing: 0.04em;
  width: fit-content;
}

.table-card.available { border-color: #4f8e6f; }
.table-card.occupied { border-color: #c47b38; }
.table-card.reserved { border-color: #7b5c3b; }

.table-card span,
.ticket-card__meta,
.item-details small,
.inventory-card small {
  font-size: 0.95rem;
}

.pos-layout,
.checkout-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 380px;
  gap: 24px;
}

.menu-item {
  text-align: left;
  border: 1px solid rgba(217, 203, 191, 0.9);
  background: var(--surface-soft);
  border-radius: 22px;
  padding: 20px;
  min-height: 160px;
  cursor: pointer;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.menu-item:hover,
.menu-item:focus {
  transform: translateY(-3px);
  border-color: var(--accent);
  box-shadow: 0 18px 36px rgba(31,41,55,0.08);
}

.menu-item span,
.menu-item small {
  color: var(--muted);
  display: block;
}

.menu-item strong {
  display: block;
  font-size: 1.1rem;
  margin: 12px 0 8px;
}

.order-panel {
  position: sticky;
  top: 24px;
  align-self: start;
}

.cart-empty {
  min-height: 260px;
  display: grid;
  place-items: center;
  color: var(--muted);
  border: 2px dashed rgba(217, 203, 191, 0.8);
  border-radius: 22px;
  text-align: center;
  padding: 22px;
  background: var(--surface-soft);
}

.open-orders {
  display: grid;
  gap: 14px;
  max-height: 300px;
  overflow: auto;
}

.open-orders a {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid rgba(217, 203, 191, 0.9);
  border-radius: 18px;
  padding: 16px;
  color: var(--ink);
  text-decoration: none;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.open-orders a:hover {
  border-color: var(--accent);
  transform: translateY(-2px);
}

.kitchen-ticket { min-height: 190px; border-left: 5px solid var(--accent); }

.ticket-card {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.ticket-card__header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
}

.ticket-card__header strong {
  font-size: 1.1rem;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 700;
  background: rgba(143, 106, 69, 0.12);
  color: #8f6a45;
}

.status-pill--sent { background: rgba(191, 90, 34, 0.12); color: #9a421c; }
.status-pill--preparing { background: rgba(113, 82, 44, 0.12); color: #794f2a; }
.status-pill--ready { background: rgba(111, 158, 99, 0.12); color: #2f5e31; }
.status-pill--paid { background: rgba(52, 110, 79, 0.12); color: #1d5a3d; }

.ticket-card__items { display: grid; gap: 14px; }

.ticket-item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 14px;
  align-items: center;
  padding: 16px 18px;
  border: 1px solid rgba(217, 203, 191, 0.9);
  border-radius: 18px;
  background: var(--surface-soft);
}

.item-qty {
  min-width: 48px;
  min-height: 48px;
  border-radius: 16px;
  background: var(--accent);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
}

.item-details strong {
  display: block;
  font-size: 1rem;
}

.item-details small {
  margin-top: 4px;
}

.ticket-card__footer {
  display: flex;
  justify-content: flex-end;
}

.summary-chip {
  display: inline-flex;
  flex-direction: column;
  gap: 8px;
  background: var(--surface);
  border: 1px solid rgba(217, 203, 191, 0.9);
  border-radius: 24px;
  padding: 18px 22px;
  box-shadow: var(--shadow);
  max-width: 320px;
}

.summary-chip span {
  letter-spacing: 0.08em;
}

.summary-chip strong {
  font-size: 2.5rem;
}

.empty-state {
  color: var(--muted);
  font-size: 1.05rem;
  padding: 36px 22px;
  background: var(--surface);
  border: 1px dashed rgba(217, 203, 191, 0.9);
  border-radius: 20px;
  text-align: center;
}
