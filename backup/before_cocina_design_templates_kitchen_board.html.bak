{% extends 'base.html' %}
{% block title %}Cocina | Bemba{% endblock %}
{% block heading %}Cocina y comandas{% endblock %}
{% block content %}
<section class="kanban">
  {% for ticket in tickets %}
  <article class="kitchen-ticket">
    <strong>Pedido #{{ ticket.order.id }} - Mesa {{ ticket.order.table.number }}</strong>
    <span>{{ ticket.get_status_display }}</span>
    {% for item in ticket.order.items.all %}
    <p>{{ item.quantity }} x {{ item.menu_item.name }}{% if item.notes %} - {{ item.notes }}{% endif %}</p>
    {% endfor %}
    <a class="btn btn-sm btn-outline-dark mt-2" href="{% url 'checkout' ticket.order.id %}">Cobrar pedido</a>
  </article>
  {% empty %}<p>No hay comandas pendientes.</p>{% endfor %}
</section>
{% endblock %}
