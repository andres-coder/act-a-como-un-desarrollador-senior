{% extends 'base.html' %}
{% block title %}Inventario | Bemba{% endblock %}
{% block heading %}Inventario{% endblock %}
{% block content %}
<section class="panel">
  <div class="panel-title">Ingredientes</div>
  <table class="table">
    <thead><tr><th>Ingrediente</th><th>Stock</th><th>Mínimo</th><th>Costo</th></tr></thead>
    <tbody>{% for ingredient in ingredients %}<tr><td>{{ ingredient.name }}</td><td>{{ ingredient.current_stock }} {{ ingredient.unit }}</td><td>{{ ingredient.min_stock }}</td><td>${{ ingredient.unit_cost }}</td></tr>{% endfor %}</tbody>
  </table>
</section>
{% endblock %}
