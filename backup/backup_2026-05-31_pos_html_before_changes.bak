{% extends 'base.html' %}
{% block title %}POS | Bemba{% endblock %}
{% block heading %}Punto de venta{% endblock %}
{% block content %}
<section class="pos-layout">
  {% csrf_token %}
  <div class="panel pos-menu">
    <div class="panel-title">Menú</div>
    <div class="menu-grid">
      {% for item in items %}
      <button class="menu-item" data-id="{{ item.id }}" data-price="{{ item.price }}">
        <span>{{ item.category.name }}</span>
        <strong>{{ item.name }}</strong>
        <small>${{ item.price }}</small>
      </button>
      {% empty %}
      <p>No hay productos disponibles.</p>
      {% endfor %}
    </div>
  </div>

  <aside class="panel order-panel">
    <div class="panel-title">Ticket activo</div>
    <select id="table-select" class="form-select mb-3">
      {% for table in tables %}
      <option value="{{ table.id }}">Mesa {{ table.number }} - {{ table.zone.name }}</option>
      {% endfor %}
    </select>
    <div id="cart" class="cart-empty">Selecciona productos para crear el pedido.</div>
    <div id="pos-message" class="small mt-3"></div>
    <button id="send-kitchen" class="btn btn-dark w-100 mt-3" type="button">Enviar a cocina</button>

    <hr>
    <div class="panel-title">Pedidos abiertos</div>
    <div class="open-orders">
      {% for order in open_orders %}
      <a href="{% url 'checkout' order.id %}">
        <span>#{{ order.id }} - Mesa {{ order.table.number }}</span>
        <strong>${{ order.total }}</strong>
      </a>
      {% empty %}
      <small class="text-muted">No hay pedidos pendientes de cobro.</small>
      {% endfor %}
    </div>
  </aside>
</section>
{% endblock %}
