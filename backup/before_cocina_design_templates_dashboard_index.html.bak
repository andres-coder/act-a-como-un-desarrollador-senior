{% extends 'base.html' %}
{% block title %}Dashboard | Bemba{% endblock %}
{% block heading %}Dashboard administrativo{% endblock %}
{% block content %}
<section class="metric-grid">
  <article class="metric"><span>Ventas</span><strong>${{ sales_today }}</strong></article>
  <article class="metric"><span>Pedidos abiertos</span><strong>{{ open_orders }}</strong></article>
  <article class="metric"><span>Mesas ocupadas</span><strong>{{ occupied_tables }}</strong></article>
  <article class="metric"><span>Stock crítico</span><strong>{{ low_stock }}</strong></article>
</section>
<section class="panel">
  <div class="panel-title">Pedidos recientes</div>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Pedido</th><th>Mesa</th><th>Mesero</th><th>Estado</th><th>Total</th></tr></thead>
      <tbody>
        {% for order in recent_orders %}
        <tr><td>#{{ order.id }}</td><td>{{ order.table.number }}</td><td>{{ order.waiter }}</td><td><span class="badge text-bg-secondary">{{ order.get_status_display }}</span></td><td>${{ order.total }}</td></tr>
        {% empty %}<tr><td colspan="5">Sin pedidos registrados.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
